{
  "components": {
    "schemas": {
      "AgentSettings": {
        "additionalProperties": false,
        "properties": {
          "decision1_base_url": {
            "default": "http://127.0.0.1:11434/v1",
            "maxLength": 500,
            "title": "Decision1 Base Url",
            "type": "string"
          },
          "decision1_enabled": {
            "default": false,
            "title": "Decision1 Enabled",
            "type": "boolean"
          },
          "decision1_model": {
            "default": "decision-1",
            "maxLength": 150,
            "minLength": 1,
            "title": "Decision1 Model",
            "type": "string"
          },
          "execution_mode": {
            "default": "observe",
            "enum": [
              "observe",
              "paper",
              "live"
            ],
            "title": "Execution Mode",
            "type": "string"
          },
          "fee_bps": {
            "default": 10,
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Fee Bps",
            "type": "number"
          },
          "initial_cash": {
            "default": 10000,
            "exclusiveMinimum": 0.0,
            "maximum": 1000000000.0,
            "title": "Initial Cash",
            "type": "number"
          },
          "live_execution_enabled": {
            "default": false,
            "title": "Live Execution Enabled",
            "type": "boolean"
          },
          "live_max_order_usdt": {
            "default": 25,
            "maximum": 10000.0,
            "minimum": 5.0,
            "title": "Live Max Order Usdt",
            "type": "number"
          },
          "live_max_spread_bps": {
            "default": 50,
            "exclusiveMinimum": 0.0,
            "maximum": 500.0,
            "title": "Live Max Spread Bps",
            "type": "number"
          },
          "live_total_budget_usdt": {
            "default": 100,
            "maximum": 100000.0,
            "minimum": 5.0,
            "title": "Live Total Budget Usdt",
            "type": "number"
          },
          "llm_api_key_env": {
            "const": "LLM_API_KEY",
            "default": "LLM_API_KEY",
            "title": "Llm Api Key Env",
            "type": "string"
          },
          "llm_base_url": {
            "default": "http://127.0.0.1:11434/v1",
            "maxLength": 500,
            "title": "Llm Base Url",
            "type": "string"
          },
          "llm_enabled": {
            "default": false,
            "title": "Llm Enabled",
            "type": "boolean"
          },
          "llm_model": {
            "default": "qwen3:8b",
            "maxLength": 150,
            "minLength": 1,
            "title": "Llm Model",
            "type": "string"
          },
          "max_daily_loss": {
            "default": 0.02,
            "exclusiveMinimum": 0.0,
            "maximum": 0.5,
            "title": "Max Daily Loss",
            "type": "number"
          },
          "max_drawdown": {
            "default": 0.05,
            "exclusiveMinimum": 0.0,
            "maximum": 0.5,
            "title": "Max Drawdown",
            "type": "number"
          },
          "max_feed_age_seconds": {
            "default": 360,
            "maximum": 86400.0,
            "minimum": 1.0,
            "title": "Max Feed Age Seconds",
            "type": "number"
          },
          "max_position_fraction": {
            "default": 0.2,
            "exclusiveMinimum": 0.0,
            "maximum": 1.0,
            "title": "Max Position Fraction",
            "type": "number"
          },
          "planner_interval_seconds": {
            "default": 300,
            "maximum": 86400.0,
            "minimum": 1.0,
            "title": "Planner Interval Seconds",
            "type": "number"
          },
          "poll_seconds": {
            "default": 10,
            "maximum": 3600.0,
            "minimum": 1.0,
            "title": "Poll Seconds",
            "type": "number"
          },
          "shadow_interval_seconds": {
            "default": 86400,
            "maximum": 604800.0,
            "minimum": 3600.0,
            "title": "Shadow Interval Seconds",
            "type": "integer"
          },
          "shadow_learning_enabled": {
            "default": true,
            "title": "Shadow Learning Enabled",
            "type": "boolean"
          },
          "shadow_minimum_bars": {
            "default": 400,
            "maximum": 500.0,
            "minimum": 320.0,
            "title": "Shadow Minimum Bars",
            "type": "integer"
          },
          "shadow_training_steps": {
            "default": 1024,
            "maximum": 100000.0,
            "minimum": 128.0,
            "title": "Shadow Training Steps",
            "type": "integer"
          },
          "slippage_bps": {
            "default": 2,
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Slippage Bps",
            "type": "number"
          },
          "statistics_guard_enabled": {
            "default": true,
            "title": "Statistics Guard Enabled",
            "type": "boolean"
          },
          "stop_loss_fraction": {
            "default": 0.03,
            "exclusiveMinimum": 0.0,
            "maximum": 0.5,
            "title": "Stop Loss Fraction",
            "type": "number"
          },
          "symbols": {
            "items": {
              "type": "string"
            },
            "maxItems": 10,
            "minItems": 1,
            "title": "Symbols",
            "type": "array"
          }
        },
        "title": "AgentSettings",
        "type": "object"
      },
      "CredentialUpdate": {
        "additionalProperties": false,
        "properties": {
          "abantether": {
            "anyOf": [
              {
                "format": "password",
                "type": "string",
                "writeOnly": true
              },
              {
                "type": "null"
              }
            ],
            "title": "Abantether"
          },
          "decision1": {
            "anyOf": [
              {
                "items": {
                  "format": "password",
                  "type": "string",
                  "writeOnly": true
                },
                "maxItems": 16,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Decision1"
          },
          "llm": {
            "anyOf": [
              {
                "items": {
                  "format": "password",
                  "type": "string",
                  "writeOnly": true
                },
                "maxItems": 16,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Llm"
          }
        },
        "title": "CredentialUpdate",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LabRequest": {
        "additionalProperties": false,
        "properties": {
          "allocation_fraction": {
            "default": 0.1,
            "exclusiveMinimum": 0.0,
            "maximum": 1.0,
            "title": "Allocation Fraction",
            "type": "number"
          },
          "bars": {
            "items": {
              "$ref": "#/components/schemas/MarketBar"
            },
            "maxItems": 2000,
            "minItems": 30,
            "title": "Bars",
            "type": "array"
          },
          "fee_bps": {
            "default": 10,
            "maximum": 1000.0,
            "minimum": 0.0,
            "title": "Fee Bps",
            "type": "number"
          },
          "initial_capital": {
            "default": 10000,
            "exclusiveMinimum": 0.0,
            "maximum": 1000000000000.0,
            "title": "Initial Capital",
            "type": "number"
          },
          "period": {
            "default": 14,
            "maximum": 100.0,
            "minimum": 2.0,
            "title": "Period",
            "type": "integer"
          },
          "slippage_bps": {
            "default": 2,
            "maximum": 1000.0,
            "minimum": 0.0,
            "title": "Slippage Bps",
            "type": "number"
          },
          "strategy": {
            "default": "ema_cross",
            "enum": [
              "ema_cross",
              "rsi_reversion"
            ],
            "title": "Strategy",
            "type": "string"
          }
        },
        "required": [
          "bars"
        ],
        "title": "LabRequest",
        "type": "object"
      },
      "MarketBar": {
        "additionalProperties": false,
        "properties": {
          "at": {
            "exclusiveMinimum": 0.0,
            "title": "At",
            "type": "number"
          },
          "close": {
            "exclusiveMinimum": 0.0,
            "title": "Close",
            "type": "number"
          },
          "high": {
            "exclusiveMinimum": 0.0,
            "title": "High",
            "type": "number"
          },
          "low": {
            "exclusiveMinimum": 0.0,
            "title": "Low",
            "type": "number"
          },
          "open": {
            "exclusiveMinimum": 0.0,
            "title": "Open",
            "type": "number"
          },
          "volume": {
            "minimum": 0.0,
            "title": "Volume",
            "type": "number"
          }
        },
        "required": [
          "at",
          "open",
          "high",
          "low",
          "close",
          "volume"
        ],
        "title": "MarketBar",
        "type": "object"
      },
      "StartRequest": {
        "additionalProperties": false,
        "properties": {
          "mode": {
            "default": "paper",
            "title": "Mode",
            "type": "string"
          },
          "source": {
            "default": "broker",
            "title": "Source",
            "type": "string"
          }
        },
        "title": "StartRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
