# Abantether API Configuration
# ==============================
# Get your API key from: https://abantether.com/panel/account
ABAN_TETHER_API_KEY=your-api-key-here

# Optional: Custom API endpoints (rarely needed)
# ABAN_BASE_URL=https://api.abantether.com
# ABAN_API_PREFIX=
# ABAN_MONO_BASE_URL=https://mono.abantether.com

# Training Configuration
# ==============================
# Log level for the application
TG_LOG_LEVEL=INFO

# Hardware profile selection
# Options: kaggle_t4_16gb, rtx3050_4gb, custom
HARDWARE_PROFILE=kaggle_t4_16gb

# Training device
# Options: cpu, cuda, cuda:0, cuda:1, etc.
DEVICE=cuda

# MLflow Configuration
# ==============================
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT_NAME=trading_gym

# Monitoring
# ==============================
# Prometheus metrics port
METRICS_PORT=8000

# Enable TensorBoard logging
TENSORBOARD_ENABLED=true
TENSORBOARD_LOG_DIR=./tensorboard_logs

# Data Configuration
# ==============================
# Path to market data
DATA_PATH=./data

# Feature cache directory
FEATURE_CACHE_DIR=./cache/features

# Model Configuration
# ==============================
# Model checkpoints directory
CHECKPOINT_DIR=./checkpoints

# Maximum checkpoints to keep
MAX_CHECKPOINTS=5

# Auto-save frequency (in steps)
CHECKPOINT_FREQUENCY=10000

# Risk Management
# ==============================
# Maximum drawdown before stopping (percentage)
MAX_DRAWDOWN_PCT=20.0

# Maximum leverage
MAX_LEVERAGE=5.0

# Position size limit (percentage of equity)
MAX_POSITION_SIZE_PCT=50.0

# Paper Trading Configuration
# ==============================
# Enable paper trading mode
PAPER_TRADING=true

# Initial paper trading balance
PAPER_INITIAL_BALANCE=10000.0

# Development Settings
# ==============================
# Enable debug mode
DEBUG=false

# Enable profiling
PROFILING_ENABLED=false

# Random seed for reproducibility
RANDOM_SEED=42

# Advanced Settings
# ==============================
# Number of parallel environments
N_ENVS=1

# Number of data loading workers
NUM_WORKERS=2

# Enable mixed precision training
MIXED_PRECISION=true

# Gradient accumulation steps
GRADIENT_ACCUMULATION_STEPS=1

# Alerting Configuration
# ==============================
# Configure alert channels for critical events (circuit breakers, errors, etc.)

# Telegram Alerts
# Get bot token from @BotFather on Telegram
# Get chat_id by messaging your bot and visiting: https://api.telegram.org/bot<TOKEN>/getUpdates
ALERT_TELEGRAM_ENABLED=false
ALERT_TELEGRAM_BOT_TOKEN=your-bot-token-here
ALERT_TELEGRAM_CHAT_ID=your-chat-id-here
ALERT_TELEGRAM_MIN_LEVEL=warning

# Generic Webhook Alerts
# Send alerts to any HTTP endpoint
ALERT_WEBHOOK_ENABLED=false
ALERT_WEBHOOK_URL=https://your-webhook-url.com/alerts
# SECURITY WARNING: Use ONLY trusted external HTTPS endpoints.
# DO NOT set this to localhost (127.0.0.1), 0.0.0.0, or private LAN IPs (e.g., 192.168.x.x).
# Using internal addresses creates a Server-Side Request Forgery (SSRF) vulnerability
# that could be exploited to access internal services.
ALERT_WEBHOOK_METHOD=POST
ALERT_WEBHOOK_MIN_LEVEL=warning
# Optional: Custom headers as JSON string
# ALERT_WEBHOOK_HEADERS={"Authorization": "Bearer YOUR_TOKEN"}

# Desktop Notifications
# Show critical alerts as desktop notifications (Windows/macOS/Linux)
ALERT_DESKTOP_ENABLED=false
ALERT_DESKTOP_MIN_LEVEL=error

# API and governance boundaries
# Generate independent high-entropy values; never reuse exchange credentials.
API_KEY=replace-with-random-api-key
WORKER_API_KEY=replace-with-independent-random-worker-key
APPROVAL_API_KEY=replace-with-separate-random-approval-key
EMERGENCY_API_KEY=replace-with-separate-random-emergency-key
# Principal secrets must be unique and must not reuse any key above.
# Roles: proposer, approver, executor, operator, auditor.
ACTOR_CREDENTIALS_JSON={"proposal-author":{"secret":"replace-with-unique-proposer-secret","roles":["proposer"]},"human-reviewer":{"secret":"replace-with-unique-approver-secret","roles":["approver"]},"runtime-executor":{"secret":"replace-with-unique-executor-secret","roles":["executor"]}}
# Audit option A: one key, at least 32 bytes.
AUDIT_HMAC_KEY=replace-with-at-least-32-random-bytes
# Audit option B for deliberate rotation; do not set together with AUDIT_HMAC_KEY.
# AUDIT_HMAC_KEYRING_JSON={"audit-2026-q3":"replace-with-at-least-32-random-bytes","audit-2026-q4":"replace-with-another-32-byte-secret"}
# AUDIT_HMAC_KEY_ID=audit-2026-q4
API_HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
TRADING_GYM_HOME=~/.trading-gym
TRADING_GYM_DEPLOYMENT_MODE=single_tenant
TRADING_GYM_TENANT_ID=default
# Multi-tenant mode is intentionally unsupported and fails closed.
TRADING_GYM_MULTI_TENANT=false

# Optional model-provider credentials are referenced by provider configuration.
# OPENAI_API_KEY=
# NEWS_API_KEY=
# FRED_API_KEY=
