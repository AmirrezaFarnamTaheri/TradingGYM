# AXIOM-1: heavy material that must never enter the history (tracked by
# SHA256SUMS instead of by git - provenance lives there, not in blobs).
to port/
.donor_extract/
node_modules/
.ruff_cache/
.serena/
frontend/dist/

# Rust kernel build artifacts (ADR-035). The crate source is tracked; the
# compiled cdylib is a per-platform build product, and the Python loader
# treats an absent artifact as a supported state.
rust/*/target/

# Lockfile from the uv venv used for verification; the
# project and CI resolve dependencies through poetry.lock.
uv.lock
scratchpad/
